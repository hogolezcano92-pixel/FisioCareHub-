{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/stripe/:action",
      "destination": "/api/stripe-webhook?action=:action"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/test-whatsapp",
      "schedule": "0 8 * * *"
    }
  ]
}
